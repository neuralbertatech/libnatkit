FROM gcc:14.2-bookworm
WORKDIR /libnatkit

RUN apt update
RUN apt install cmake gdb -y

COPY . ./
RUN cmake -B build -S . -DCMAKE_BUILD_TYPE=Debug
RUN cmake --build build --parallel 16

# Verify binary was built and check dependencies
RUN echo "Checking binary..." && \
    ls -lh /libnatkit/build/libnatkit/tools/src/libnatkit-kafka-mosquitto-bridge && \
    file /libnatkit/build/libnatkit/tools/src/libnatkit-kafka-mosquitto-bridge && \
    ldd /libnatkit/build/libnatkit/tools/src/libnatkit-kafka-mosquitto-bridge || echo "ldd check failed"

# Enable core dumps for debugging
RUN mkdir -p /cores
RUN echo "/cores/core.%e.%p" > /proc/sys/kernel/core_pattern || true

# Install wait-for-it or similar tool to wait for services
RUN apt install -y netcat-openbsd

CMD sh -c 'echo "Waiting for Kafka..."; \
    while ! nc -z natkit-v0-kafka 9092; do sleep 1; done; \
    echo "Waiting for Mosquitto..."; \
    while ! nc -z mosquitto 1883; do sleep 1; done; \
    echo "Starting bridge with gdb..."; \
    ulimit -c unlimited; \
    gdb -batch -ex "run" -ex "bt" -ex "quit" --args /libnatkit/build/libnatkit/tools/src/libnatkit-kafka-mosquitto-bridge natkit-v0-kafka:9092 mosquitto:1883 || \
    (echo "Bridge crashed, checking for core dump..."; ls -la /cores/; cat /proc/sys/kernel/core_pattern; exit 1)'
