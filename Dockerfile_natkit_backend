#FROM drogonframework/drogon:latest
FROM docker.io/library/gcc:14.2-bookworm
WORKDIR /libnatkit

ARG NATKIT_CMAKE_BUILD_PARALLEL
# Propagate the job cap to the nested libnatkit-core ExternalProject build so a
# small Docker VM (macOS) doesn't OOM. Empty => CMake falls back to its default.
ENV CMAKE_BUILD_PARALLEL_LEVEL=${NATKIT_CMAKE_BUILD_PARALLEL}

RUN apt update
RUN apt install cmake -y
RUN apt install build-essential -y 
RUN apt install -y libjsoncpp-dev libssl-dev zlib1g-dev libsqlite3-dev uuid-dev
#RUN apt install dos2unix -y

COPY . ./
#RUN find . -type f -print0 | xargs -0 dos2unix
RUN ls /usr/include/jsoncpp/json
RUN ls /usr/local/lib
RUN g++ -xc++ -E -v - < /dev/null
RUN gcc -v -E - < /dev/null 2>&1 | awk '/#include <...> search starts here:/ {f=1; next} /End of search list./ {f=0} f' | xargs ls


RUN cmake -B third-party/drogon/build -S third-party/drogon -DCMAKE_BUILD_TYPE=Release
RUN sh -lc 'jobs="${NATKIT_CMAKE_BUILD_PARALLEL:-}"; \
    if [ -z "$jobs" ]; then \
      detected="$(getconf _NPROCESSORS_ONLN 2>/dev/null || nproc)"; \
      jobs=$((detected > 2 ? detected - 4 : 1)); \
    fi; \
    cmake --build third-party/drogon/build --parallel "$jobs"'
RUN cmake --install third-party/drogon/build
RUN ln -s /usr/include/jsoncpp/json /usr/include/json

#CMD exec /bin/sh -c "trap : TERM INT; sleep infinity & wait"

RUN cmake -B build -S . -DCMAKE_BUILD_TYPE=Release -DBUILD_NATKIT_BACKEND=ON
RUN sh -lc 'jobs="${NATKIT_CMAKE_BUILD_PARALLEL:-}"; \
    if [ -z "$jobs" ]; then \
      detected="$(getconf _NPROCESSORS_ONLN 2>/dev/null || nproc)"; \
      jobs=$((detected > 2 ? detected - 4 : 1)); \
    fi; \
    cmake --build build --parallel "$jobs"'
RUN mkdir /cores
RUN mkdir /logs
RUN ulimit -c unlimited

CMD while true; do /libnatkit/build/libnatkit/tools/src/libnatkit-natkit-backend 2>&1 | tee "/logs/log_$(date +'%Y-%m-%d_%H-%M-%S.%3N').log"; sleep 5; done
