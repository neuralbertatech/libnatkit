	cd /home/zach/code/natKit/libnatkit/build-codex && $(MAKE) $(MAKESILENT) -f libnatkit/tools/src/CMakeFiles/libnatkit-natkit-backend.dir/build.make libnatkit/tools/src/CMakeFiles/libnatkit-natkit-backend.dir/main/cxx/libnatkit/tools/StreamViewerWebSocket.cpp.i
.PHONY : main/cxx/libnatkit/tools/StreamViewerWebSocket.cpp.i

main/cxx/libnatkit/tools/StreamViewerWebSocket.s: main/cxx/libnatkit/tools/StreamViewerWebSocket.cpp.s
.PHONY : main/cxx/libnatkit/tools/StreamViewerWebSocket.s

